# OVH API credentials for the *.nohonu.com wildcard certificate (ACME DNS-01).
# Copy to /etc/edge/edge.env (mode 600) on the host. Never commit real values.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# The basic-auth hash for logs.unrom.com is NOT in this file: it lives in
# /etc/edge/stats-auth, root-owned, mode 600, and is read through {file.*}.
#   docker run --rm -it caddy:2 caddy hash-password | sudo tee /etc/edge/stats-auth >/dev/null
#   sudo chmod 600 /etc/edge/stats-auth
# Root ownership matters: the container drops CAP_DAC_OVERRIDE.
# Apply with `docker compose up -d --wait --force-recreate caddy`: a plain
# reload keeps the cached hash because the config text did not change.
