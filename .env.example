# OVH API credentials for the *.nohonu.com wildcard certificate (ACME DNS-01).
# Copy to /etc/edge/edge.env (mode 600) on the host. Never commit real values.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Basic auth for logs.unrom.com (the traffic report). Generate with:
#   docker run --rm caddy:2 caddy hash-password
# Leave it unset to keep the account locked out.
# STATS_AUTH_HASH=
