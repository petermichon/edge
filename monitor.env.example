# Monitoring destinations for bin/monitor.sh.
# Copy to /etc/edge/monitor.env, mode 600, owned by the account running
# edge-monitor.service (debian). Never commit real values.

# Plain-text POST target for failures. An ntfy topic needs no account:
#   ALERT_WEBHOOK_URL=https://ntfy.sh/<random-topic>
# Any endpoint that accepts a text body works (Healthchecks.io, a small
# webhook receiver, ...).
ALERT_WEBHOOK_URL=

# Optional Healthchecks.io ping URL, e.g. https://hc-ping.com/<uuid>.
# It is pinged when everything passes, so the service alerts when the host or
# its network dies and the pings stop. This is the only check that can see a
# dead host; the timer itself runs on that host.
MONITOR_PING_URL=

# Warn this many days before a certificate expires.
MONITOR_CERT_DAYS=14
