# hardvoxel — see https://github.com/petermichon/hardvoxel
hardvoxel.com {
	encode zstd gzip
	import security_headers
	import logging hardvoxel

	header {
		# Temporary until the v1 launch. Remove this at launch.
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy hardvoxel-web:3000
}

www.hardvoxel.com {
	import security_headers
	redir https://hardvoxel.com{uri} permanent
}
