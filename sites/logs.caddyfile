# Traffic statistics: GoAccess's HTML report over Caddy's access logs.
#
# The report contains client IPs, so it is never public and never indexed.
# The password hash lives in /etc/edge/stats-auth (mode 600, outside the repo),
# read through a global placeholder: rotating it is a `caddy reload`, and the
# secret never enters the container environment.
logs.unrom.com {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	basic_auth {
		admin {file./etc/edge/stats-auth}
	}

	root * /srv/stats
	file_server
}
