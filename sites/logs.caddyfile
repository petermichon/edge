# Traffic statistics: GoAccess's HTML report over Caddy's access logs.
#
# The report contains client IPs, so it is never public and never indexed.
# The password hash lives in /etc/edge/stats-auth (root-owned, mode 600, outside
# the repo) and is read through a global placeholder at config load.
# Rotating it needs a recreate, not a reload: a reload of an unchanged config
# does not re-provision the handler, so the cached hash survives. See README.
logs.unrom.com {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	basic_auth {
		admin {file./etc/edge/stats-auth}
	}

	root * /srv/stats
	file_server
}
