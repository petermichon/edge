# unrom — see https://github.com/petermichon/unrom
unrom.com {
	encode zstd gzip
	import security_headers

	# The bare /api path is the API's index, so match it as well as /api/*.
	@api path /api /api/*
	handle @api {
		reverse_proxy unrom-api:3000
	}

	handle {
		reverse_proxy unrom-web:3001
	}
}

www.unrom.com {
	import security_headers
	redir https://unrom.com{uri} permanent
}
